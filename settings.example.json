{
  "orca_cli": "orca-ide",
  "poll_seconds": 5,
  "worker_timeout_seconds": 7200,
  "provider_cooldown_seconds": 900,
  "catalog": "catalog.json",
  "selection": "selection.json",
  "recovery": {
    "auto_resume_automation": false,
    "return_to_preferred_on_next_task": true,
    "delayed_resume_delay_seconds": 900,
    "health_probe_timeout_seconds": 30,
    "max_probe_attempts": 3,
    "max_resume_attempts": 3,
    "max_supervise_actions": 20,
    "bots_dir": "~/.orca/bots",
    "once_deadline_seconds": 300
  },
  "sources": {
    "ocx_url": "http://127.0.0.1:10100/v1/models",
    "ocx_command": "ocx",
    "agy_command": "agy",
    "openrouter_url": "https://openrouter.ai/api/v1/models"
  }
}
